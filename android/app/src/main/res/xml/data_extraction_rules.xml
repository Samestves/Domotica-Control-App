<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o más nuevo: nada de la app va al respaldo de Google ni pasa a otro teléfono al cambiarlo.
     Así la clave de la casa y la contraseña Wi-Fi no salen del teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
